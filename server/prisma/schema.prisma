// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id              String      @id @default(uuid())
  email           String      @unique
  passwordHash    String
  firstName       String?
  lastName        String?
  role            UserRole    @default(USER)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  ownedWorkspaces Workspace[] @relation("workspaceOwner")
  workspaces      Workspace[] @relation("workspaceMembers")
}

model Workspace {
  id           String             @id @default(uuid())
  ownerId      String
  owner        User               @relation(name: "workspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  name         String             @default("My Workspace")
  defaultModel String             @default("gpt-4o-mini")
  chats        Chat[]
  sources      Source[]
  users        User[]             @relation("workspaceMembers")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  artifacts    LearningArtifact[]

  @@index([ownerId])
}

model Chat {
  id                  String    @id @default(uuid())
  workspaceId         String
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title               String
  summary             String?
  summaryMessageCount Int       @default(0)
  summarizedAt        DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  messages            Message[]

  @@index([workspaceId])
  @@index([workspaceId, updatedAt])
}

model Message {
  id        String      @id @default(uuid())
  chatId    String
  role      MessageRole
  content   String
  citations Json?
  createdAt DateTime    @default(now())
  chat      Chat        @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@index([chatId, createdAt])
}

enum SourceType {
  PDF
  WEBSITE
  YOUTUBE
  TEXT
  MARKDOWN
}

enum SourceStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Source {
  id          String        @id @default(uuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  source      String?
  url         String?
  fileUrl     String?
  metadata    Json?
  type        SourceType
  title       String        @default("My Mosaic")
  status      SourceStatus  @default(PENDING)
  error       String?
  chunks      SourceChunk[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, type])
}

model SourceChunk {
  id         String   @id @default(uuid())
  sourceId   String
  index      Int
  content    String
  tokenCount Int?
  metadata   Json?
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime @default(now())
  source     Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@index([sourceId, index])
}

enum MessageRole {
  USER
  ASSISTANT
}

enum ArtifactType {
  SUMMARY
  TAKEAWAYS
  FLASHCARDS
  QUIZ
  MINDMAP
  REPORT
}

enum ArtifactStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model LearningArtifact {
  id          String         @id @default(uuid())
  workspaceId String
  type        ArtifactType
  status      ArtifactStatus @default(PENDING)
  title       String
  content     Json?
  sourceIds   String[]
  metadata    Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, type])
  @@index([workspaceId, status])
}
